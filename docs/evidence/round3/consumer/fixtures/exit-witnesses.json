  "dns": {
    "rules": [
      {
        "query_type": "HTTPS",
        "action": "predefined"
      },
      {
        "preferred_by": "hosts",
        "server": "hosts",
        "timeout": "1s"
      },
      {
        "domain": "local",
        "query_type": "SOA",
        "action": "predefined"
      },
      {
        "preferred_by": "dns_mdns",
        "server": "dns_mdns",
        "timeout": "2s",
        "disable_optimistic_cache": true
      },
      {
        "domain_suffix": [
          "in-addr.arpa",
          "ipv4only.arpa",
          "ip6.arpa"
        ],
        "server": "dns_local"
      },
      {
        "rule_set": "geosite-private",
        "server": "dns_local"
      },
      {
        "clash_mode": "Direct",
        "server": "dns_direct",
        "timeout": "3s"
      },
      {
        "clash_mode": "Global",
        "server": "dns_proxy",
        "timeout": "4s"
      },
      {
        "domain": [
          "datav.aliyun.com",
          "checkonline.home-assistant.io",
          "version.home-assistant.io"
        ],
        "domain_suffix": [
          "youdian.studio",
          "mi.com",
          "xiaomi.com",
          "tapnow.media",
          "tapnow.top",
          "xiaomi.net",
          "djivideos.com"
        ],
        "server": "dns_direct",
        "timeout": "3s"
      },
      {
        "rule_set": "geosite-apple-tvplus",
        "server": "dns_proxy",
        "timeout": "4s"
      },
      {
        "domain_suffix": "push.apple.com",
        "server": "dns_direct",
        "timeout": "3s"
      },
      {
        "rule_set": [
          "geosite-tencent",
          "geosite-alibaba",
          "geosite-bilibili",
          "geosite-douyin",
          "geosite-apple@cn",
          "geosite-xiaomi",
          "geosite-dji"
        ],
        "server": "dns_direct",
        "timeout": "3s"
      },
      {
        "rule_set": "geosite-apple",
        "server": "dns_proxy",
        "timeout": "4s"
      },
      {
        "rule_set": "geosite-google",
        "query_type": "AAAA",
        "action": "predefined"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-youtube"
        ],
        "server": "dns_proxy",
        "timeout": "4s"
      },
      {
        "rule_set": [
          "geosite-anthropic",
          "geosite-openai",
          "geosite-ai"
        ],
        "query_type": "AAAA",
        "action": "predefined"
      },
      {
        "rule_set": [
          "geosite-anthropic",
          "geosite-openai",
          "geosite-ai"
        ],
        "server": "dns_proxy",
        "timeout": "4s"
      },
      {
        "rule_set": [
          "geosite-github",
          "geosite-tiktok",
          "geosite-twitter",
          "geosite-meta",
          "geosite-netflix",
          "geosite-telegram",
          "geosite-adobe",
          "geosite-cloudflare",
          "geosite-fastly"
        ],
        "server": "dns_proxy",
        "timeout": "4s"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns_direct",
        "timeout": "2s"
      },
      {
        "action": "evaluate",
        "server": "dns_proxy",
        "timeout": "2s",
        "client_subnet": "114.114.114.0/24"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "server": "dns_direct",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "action": "respond"
      }
    ],
    "final": "dns_proxy"
  },
  "route_rules": [
    {
      "network": "icmp",
      "preferred_by": "bridge",
      "outbound": "bridge"
    },
    {
      "type": "logical",
      "mode": "and",
      "rules": [
        {
          "network": "tcp"
        },
        {
          "ip_is_private": true
        },
        {
          "port": [
            53
          ],
          "invert": true
        }
      ],
      "action": "bypass"
    },
    {
      "port": 853,
      "action": "reject",
      "no_drop": true
    },
    {
      "action": "sniff",
      "sniffer": [
        "tls",
        "quic",
        "http",
        "dns",
        "ssh",
        "bittorrent"
      ],
      "timeout": "80ms"
    },
    {
